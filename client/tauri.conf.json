{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCRN",
  "version": "0.0.0",
  "identifier": "de.andreaslink.scrn",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' scrn: http://scrn.localhost; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
