{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCRN",
  "identifier": "de.andreaslink.scrn",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: scrn: http://scrn.localhost; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "Andreas Link",
    "copyright": "© 2026 Andreas Link, MIT License",
    "license": "MIT",
    "homepage": "https://github.com/andreaslink-de/scrn",
    "category": "Utility",
    "shortDescription": "Screenshots to your own SCRN server",
    "longDescription": "Take a screenshot, select an area, add arrows, highlights and blurred areas, and upload it to your own SCRN server. The short link lands on the clipboard.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "graphics",
        "recommends": [
          "xdg-desktop-portal-gnome | xdg-desktop-portal",
          "gnome-keyring"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
