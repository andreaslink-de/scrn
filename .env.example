# SCRN configuration. Copy to .env and adjust. Never commit .env.

# Public base URL without a trailing slash. Short links are <base>/<id>.
SCRN_BASE_URL=http://localhost:8080

# Address the server listens on inside the container.
SCRN_BIND=0.0.0.0:8080

# Directory for the SQLite database (scrn.db) and screenshot files (files/).
SCRN_DATA_DIR=/data

# Set the Secure attribute on session cookies. Use false only for local
# development over plain http.
SCRN_COOKIE_SECURE=true

# Comma-separated IP addresses or CIDR ranges of reverse proxies whose
# X-Forwarded-* headers are trusted, e.g. the Nginx Proxy Manager container.
# Empty means no proxy is trusted.
SCRN_TRUSTED_PROXIES=

# Storage quota per user in MiB for users without their own quota.
# 0 means unlimited. Administrators can set a different quota per user.
SCRN_DEFAULT_QUOTA_MB=1024

# Log filter (tracing EnvFilter syntax), e.g. info or scrn_server=debug.
RUST_LOG=info

# Log format: text (default) or json.
SCRN_LOG_FORMAT=text

# --- Docker Compose only ---------------------------------------------------

# Image to run. Empty builds it from the checkout; for a server use a
# release, e.g. ghcr.io/andreaslink-de/scrn:0.1.0.
SCRN_IMAGE=

# Host address and port the container port is published on.
SCRN_PUBLISH_ADDR=127.0.0.1
SCRN_PUBLISH_PORT=8080

# UID and GID the container runs as. Must own ./data on the host.
SCRN_UID=1000
SCRN_GID=1000
